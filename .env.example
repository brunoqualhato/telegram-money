# Copie para .env. Gere senhas únicas; nunca versione este arquivo preenchido.
OWNER_EMAIL=voce@example.com
OWNER_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=sqlite:///./data/telegram-money.db
REDIS_URL=redis://localhost:6379/0
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
TIMEZONE=America/Sao_Paulo
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BRAPI_TOKEN=
POLL_SECONDS=120
# Gateway padrão de IA: LM Studio. Informe o ID exato de um modelo carregado.
AI_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://localhost:1235/v1
LM_STUDIO_MODEL=qwen3.5-9b
# Opcional: preencha se o servidor LM Studio exigir autenticação.
LM_STUDIO_API_KEY=
AI_TIMEOUT_SECONDS=180
# Alternativa opcional: AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
DEMO_MODE=false
