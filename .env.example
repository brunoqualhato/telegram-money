# ==============================================================================
# Telegram Money · Configuração de Infraestrutura
#
# Configure a infraestrutura aqui. Acesso e integrações podem ser preparados pelo
# assistente CLI ou pelo Setup Wizard web, quando ainda não existir proprietário.
# Valores de integração salvos no painel prevalecem sobre os equivalentes no .env.
# ==============================================================================

# Senha do banco PostgreSQL (obrigatória ao usar Docker/Compose)
POSTGRES_PASSWORD=

# URLs de infraestrutura e serviços base
DATABASE_URL=sqlite:///./data/telegram-money.db
REDIS_URL=redis://localhost:6379/0

# Origem autorizada e segurança de cookies
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false

# Gateways fora das origens locais padrão precisam de autorização explícita.
# Separe origens exatas por vírgula, sem caminho: http://192.168.1.10:1235
AI_ALLOWED_ORIGINS=

# Modo de demonstração (se true, não conecta a serviços reais)
DEMO_MODE=false
